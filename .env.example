# Salin seluruh isi file credentials.json Anda (dalam 1 baris string JSON)
# ke dalam environment variable GOOGLE_CREDENTIALS_JSON di Vercel Dashboard:
# Project Settings -> Environment Variables -> Key: GOOGLE_CREDENTIALS_JSON
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"new-metar-rec","private_key_id":"...","private_key":"...","client_email":"metarnew@new-metar-rec.iam.gserviceaccount.com",...}

